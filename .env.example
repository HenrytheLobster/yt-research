# Optional local model settings
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/generate
TRIAGE_MODEL=phi3:mini
TRIAGE_FALLBACK_MODEL=qwen3:4b
EXTRACT_MODEL=qwen3:8b
REPAIR_MODEL=phi3:mini

# Optional Gemini provider settings
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional Reddit collection settings
# REDDIT_CLIENT_ID=replace-with-your-client-id
# REDDIT_CLIENT_SECRET=replace-with-your-client-secret
# REDDIT_USER_AGENT=yt-research/0.1 (contact: you@example.com)
